{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "outDir": "./dist",
    "rootDir": "src",
    // Keep the incremental build info next to the tsconfig, not in dist/
    // (dist/ is shipped to users as the load-unpacked extension folder).
    "tsBuildInfoFile": "./.tsbuildinfo",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "src/**/*.ts"
  ]
}
