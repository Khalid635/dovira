{
  "browser_specific_settings": {
    "gecko": {
      "id": "dovira@khalid635.github.io",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_icon": "icons/icon.png",
    "default_popup": "popup.html",
    "default_title": "DOVIRA"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_idle"
    }
  ],
  "description": "Send links and videos to the DOVIRA desktop app. The app must be running on this PC.",
  "host_permissions": ["<all_urls>"],
  "icons": {
    "128": "icons/icon.png",
    "16": "icons/icon.png",
    "48": "icons/icon.png"
  },
  "manifest_version": 3,
  "name": "DOVIRA — Download with DOVIRA",
  "options_page": "options.html",
  "permissions": [
    "alarms",
    "contextMenus",
    "cookies",
    "downloads",
    "notifications",
    "storage",
    "activeTab",
    "scripting"
  ],
  "version": "1.4.0"
}
